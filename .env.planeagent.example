# PlaneAgent Environment Configuration
# This file documents the environment variables needed for cross-origin cookie support

# =============================================================================
# CROSS-ORIGIN COOKIE SETTINGS (CRITICAL FOR PLANEAGENT)
# =============================================================================
# These settings fix the login loop bug when frontend (port 80) and API (port 8000)
# run on different ports. Browsers treat different ports as cross-origin.

# Frontend URL (nginx)
WEB_URL=http://10.0.0.202

# API URL (Django)
API_BASE_URL=http://10.0.0.202:8000

# CORS settings - must include both frontend and API origins
CORS_ALLOWED_ORIGINS=http://10.0.0.202,http://10.0.0.202:8000

# Cookie domain - leave empty to use the current host
COOKIE_DOMAIN=

# SameSite cookie settings - 'None' required for cross-port cookies
# Note: When SameSite=None, browsers require Secure cookies (HTTPS)
# For HTTP-only local deployments, you may need to use 'Lax' and proxy API
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# =============================================================================
# ALTERNATIVE SOLUTION (Recommended for Production)
# =============================================================================
# Instead of using SameSite=None, proxy the API through nginx on port 80.
# This makes frontend and API same-origin, avoiding cross-origin cookie issues.
#
# nginx.conf addition:
#   location /api/ {
#       proxy_pass http://localhost:8000/api/;
#       proxy_set_header Host $host;
#       proxy_set_header X-Real-IP $remote_addr;
#       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#       proxy_set_header X-Forwarded-Proto $scheme;
#   }
#
# Then set:
#   WEB_URL=http://10.0.0.202
#   API_BASE_URL=http://10.0.0.202  # Same as WEB_URL
#   CORS_ALLOWED_ORIGINS=http://10.0.0.202
#   SESSION_COOKIE_SAMESITE=Lax
#   CSRF_COOKIE_SAMESITE=Lax

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
DATABASE_URL=postgresql://plane:plane@localhost:5432/plane

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY
# =============================================================================
SECRET_KEY=your-secret-key-here
DEBUG=0

# =============================================================================
# OPTIONAL: File Storage
# =============================================================================
# AWS_S3_BUCKET_NAME=uploads
# AWS_ACCESS_KEY_ID=access-key
# AWS_SECRET_ACCESS_KEY=secret-key
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# USE_MINIO=1